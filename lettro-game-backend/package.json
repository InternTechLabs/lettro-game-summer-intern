{
  "name": "summer-intern",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "start": "tsx src/server.ts",
    "start:dev": "nodemon --watch dist --exec 'node dist/server.js'",
    "build": "tsc",
    "start:development": "cross-env ENV_FILE=./config/.env.development.local nodemon --exec tsx src/server.ts",
    "start:staging": "cross-env ENV_FILE=./config/.env.staging.local nodemon --exec tsx src/server.ts",
    "start:beta": "cross-env ENV_FILE=./config/.env.beta.local node dist/server.js",
    "start:prod": "cross-env ENV_FILE=./config/.env.production node dist/server.js",
    "start:prod:build": "npm run build && cross-env ENV_FILE=./config/.env.production node dist/server.js",
    "lint": "eslint src/**/*.ts --quiet",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "format:check": "prettier --check src/**/*.{ts,js,json}",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:dev": "dotenv -e ./config/.env.development.local prisma migrate dev",
    "db:migrate:prod": "dotenv -e ./config/.env.prod.local prisma migrate prod",
    "db:migrate:staging": "dotenv -e ./config/.env.staging.local prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:dev": "bash ./scripts/docker-deploy.sh development",
    "docker:staging": "./scripts/docker-deploy.sh staging",
    "docker:prod": "./scripts/docker-deploy.sh production",
    "docker:stop": "docker compose down",
    "docker:stop:dev": "ENV=development docker compose down",
    "docker:stop:staging": "ENV=staging docker compose down",
    "docker:stop:prod": "ENV=production docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:logs:app": "docker compose logs -f app",
    "docker:logs:db": "docker compose logs -f postgres",
    "docker:logs:redis": "docker compose logs -f redis",
    "docker:shell": "docker compose exec app /bin/sh",
    "docker:db": "docker compose exec postgres psql -U lettro",
    "docker:redis": "docker compose exec redis redis-cli",
    "docker:health": "./scripts/health-check.sh",
    "docker:health:dev": "./scripts/health-check.sh development",
    "docker:health:staging": "./scripts/health-check.sh staging",
    "docker:health:prod": "./scripts/health-check.sh production",
    "docker:clean": "docker system prune -f",
    "docker:clean:all": "docker system prune -af"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,mjs,js,json",
    "ignore": [
      "node_modules",
      "src/**/*.spec.ts"
    ],
    "exec": "tsx src/server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.4",
    "redis": "^5.5.6",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express-session": "^1.18.2",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "jest": "^30.0.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.1",
    "prisma": "^6.10.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

# ----------------------------
# Environment Settings
# ----------------------------
ENV=development
NODE_ENV=development
BUILD_TARGET=development

# ----------------------------
# App Configuration
# ----------------------------
PORT=3000
APP_PORT=3000

# ----------------------------
# Database Configuration
# ----------------------------
DATABASE_URL=postgresql://lettro:lettro_123@postgres:5432/lettro_dev
POSTGRES_USER=lettro
POSTGRES_PASSWORD=lettro_123
POSTGRES_DB=lettro_dev
POSTGRES_PORT=5432

# ----------------------------
# Redis Configuration
# ----------------------------
REDIS_URL=redis://localhost:6379   # Constructed as a full URL
REDIS_PORT=6379
REDIS_CONFIG=                      # leave blank if optional
REDIS_HOST=redis

# ----------------------------
# Session & Cookie Security
# ----------------------------
SESSION_SECRET=supersecretkey123
COOKIE_SECRET=anotherSecretKey456

# ----------------------------
# JWT Configuration
# ----------------------------
JWT_SECRET=myjwtsecret
JWT_REFRESH_SECRET=myrefreshsecret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------
# Encryption
# ----------------------------
ENCRYPTION_KEY=strongencryptionkey123456

# ----------------------------
# SMTP Configuration
# ----------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=smtpuser
SMTP_PASS=smtppassword
SMTP_FROM=admin@example.com

# ----------------------------
# CORS / Allowed Origins (Optional)
# ----------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------
# Docker Runtime & Volumes (Optional)
# ----------------------------
VOLUME_MOUNT=/app/volume
NODE_MODULES_VOLUME=/app/node_modules

# ----------------------------
# Rate Limiting (Extra, not in schema)
# ----------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100